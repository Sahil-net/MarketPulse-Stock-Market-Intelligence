# Financial Data Provider
# Add your API key here to replace demo data with live data.
# Supported providers: Alpha Vantage, Finnhub, Twelve Data, Financial Modeling Prep
# FINANCIAL_API_PROVIDER=alphavantage
# FINANCIAL_API_KEY=your_api_key_here

# Supabase (pre-populated in Bolt environment)
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AMFI NAV data for Indian mutual funds (no key required, public API)
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
